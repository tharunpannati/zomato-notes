# Copy this file to .env and fill in your values
# Never commit your real .env file

# Auth token for DELETE /notes/{id}
X_TOKEN=your_secret_token_here

# Set to 1 to use offline mock AI (no API key needed) — this is the default/graded mode
MOCK_AI=1

# Optional: real LLM API key (Groq free tier) — only needed if MOCK_AI=0
GROQ_API_KEY=your_groq_api_key_here

# Database URL (default: local SQLite file)
DATABASE_URL=sqlite:///./zomato_notes.db
